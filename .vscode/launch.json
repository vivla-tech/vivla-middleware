{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Zendesk Middleware",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/src/app.js",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "/Users/raulalonso/.nvm/versions/node/v22.16.0/bin/node",
            "runtimeArgs": [
                "--inspect=0.0.0.0:9229",
                "--enable-source-maps"
            ],
            "env": {
                "NODE_ENV": "development",
                "PORT": "3000"
            },
            "envFile": "${workspaceFolder}/.env",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "outputCapture": "std",
            "sourceMaps": true,
            "stopOnEntry": false,
            "autoAttachChildProcesses": false,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "smartStep": true,
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "${workspaceFolder}"
        },
        {
            "name": "Attach to Server",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "address": "localhost",
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "${workspaceFolder}",
            "protocol": "inspector",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ]
        }
    ]
}
